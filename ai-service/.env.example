AI_SERVICE_NAME=ai-service
AI_SERVICE_IP=127.0.0.1
AI_SERVICE_PORT=8086
NACOS_SERVER_ADDR=localhost:8848

# ---------- 对话模型（OpenAI 兼容格式，改 base_url + model 即可切换任意服务商） ----------
# 例如阿里云百炼：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# 留空 LLM_API_KEY 或 MOCK_CHAT=true 时进入 mock 模式，无需真实调用
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
MOCK_CHAT=true

# ---------- 兼容旧配置（LLM_* 为空时回落到这里） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- Embedding（OpenAI 兼容格式，RAG 检索用；未配置时 RAG 自动降级为关键词检索） ----------
# 阿里云百炼示例：EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                 EMBEDDING_MODEL=text-embedding-v3  EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=3

# ---------- MySQL（对话消息持久化） ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=petverse_ai
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=10

# ---------- PostgreSQL + pgvector（RAG 向量库） ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=123456
PG_DB=petverse_ai
PG_POOL_MIN=1
PG_POOL_MAX=10

# ---------- RAG 检索参数 ----------
RAG_ENABLED=true
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35
RAG_COLLECTION=petverse_kb

# ---------- 业务服务地址（ai-service 直连各微服务拉取上下文） ----------
PET_SERVICE_URL=http://127.0.0.1:8081
SPACE_SERVICE_URL=http://127.0.0.1:8082
USER_SERVICE_URL=http://127.0.0.1:8083
SOCIAL_SERVICE_URL=http://127.0.0.1:8084
REMARK_SERVICE_URL=http://127.0.0.1:8085
SHOP_SERVICE_URL=http://127.0.0.1:8087
HTTP_TIMEOUT=8.0

# ---------- 功能缓存 TTL（秒） ----------
REVIEW_SUMMARY_TTL=21600
RECOMMEND_CACHE_TTL=600
HEALTH_CACHE_TTL=3600

# ---------- 对话记忆 ----------
HISTORY_MAX_MESSAGES=40
HISTORY_TTL_SECONDS=604800

# ---------- LLM 生成参数 ----------
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.8
