# ==========================================================================
# PetVerse ai-service 环境变量样例
#
# 用法：复制为 .env 后按需修改（.env 已在 .gitignore 中，不要提交密钥）。
#     cd ai-service && copy .env.example .env
#
# 说明：
#   1. 本文件列出 app/config.py 中 Settings 的**全部**配置项，等号后留空的
#      （密钥类）必须自行填写，其余留空即用代码内默认值；
#   2. 注释只支持 # 开头。用 ; 开头 python-dotenv 不认，会在每次启动时刷
#      "could not parse statement" 告警（历史 .env 里踩过）；
#   3. .env 里出现 config.py 未声明的键会被 extra="ignore" 静默忽略，
#      不报错也不生效——改配置后行为没变化，先确认键名拼写与是否已删字段。
# ==========================================================================

# ---------- 服务与 Nacos 注册 ----------
# 注册到 Nacos 的服务名：网关按 lb://ai-service 做服务发现，改名要同步网关路由
AI_SERVICE_NAME=ai-service
# 注册给网关回调的实例 IP：本机开发用 127.0.0.1，跨机部署填内网可达地址
AI_SERVICE_IP=127.0.0.1
# 服务监听端口（需与 uvicorn 启动参数一致）
AI_SERVICE_PORT=8086
NACOS_SERVER_ADDR=localhost:8848

# ---------- 对话模型（OpenAI 兼容格式，改 base_url + model 即可切换服务商） ----------
# 留空 LLM_API_KEY 或 MOCK_CHAT=true 时进入 mock 模式，返回内置模拟回复
LLM_API_KEY=
# 例：DeepSeek https://api.deepseek.com/v1 ；阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# 例：deepseek-chat / qwen-plus
LLM_MODEL=

# ---------- 兼容旧配置（LLM_* 留空时自动回落到这三项） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- 强制 mock 开关（联调 / 无 Key 验证用） ----------
MOCK_CHAT=false

# ---------- Embedding（RAG 向量检索必需，OpenAI 兼容格式） ----------
# DeepSeek 没有 embedding 接口，必须另配一家；Embedding 不会自动复用 LLM_* 的 Key
# 不配置时知识类提问直接报错（RagUnavailable），不做关键词降级
EMBEDDING_API_KEY=
# 例：阿里云百炼 https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
# 必须与 pgvector 建表维度一致（text-embedding-v3 支持 1024/768/512）
# 改这个值会导致 kb_chunk.embedding 维度与既有数据不匹配，需重建知识库
EMBEDDING_DIM=1024

# ---------- 多模态对话附件（图片 / 音频 / 视频） ----------
# 单轮对话附件数上限
CHAT_MAX_ATTACHMENTS=4
# 单个文件大小上限（MB），超限上传接口直接拒绝
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_AUDIO_MB=20
MEDIA_MAX_VIDEO_MB=50
# 视觉理解模型（OpenAI 兼容多模态对话，如百炼 qwen-vl-plus / qwen-vl-max）
# 对话模型本身支持多模态时，把 LLM_VISION_MODEL 设成与 LLM_MODEL 相同即可
# Key / BaseURL 留空自动复用上方 LLM_*（同服务商时只需填 MODEL）
# 三项配齐前，图片降级为文字占位提示，不影响对话主流程
LLM_VISION_MODEL=
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=
# 语音转写（OpenAI 兼容 /audio/transcriptions，如百炼 paraformer-v2 / whisper）
# 三项必须全部配置（不回落 LLM_*）；未配置时音频降级为文字占位提示
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=

# ---------- 阿里云 OSS（多模态附件持久化，与 Java 侧 petverse-common 共用同一个桶） ----------
# 四项配齐后附件直传 OSS（对象 key：ai-chat/{userId}/{yyyyMMdd}/{uuid}.ext），
# 公网 URL 同时用于浏览器回放与视觉模型回源拉取；缺任一项时上传接口明确报错
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
# 可选：自定义 / CDN 访问域名（含协议），为空时按「桶名.地域节点」默认域名拼接
OSS_DOMAIN=

# ---------- Redis（AI 结果缓存热层：评论摘要 / 个性化推荐） ----------
# 本机 Redis 5.0 不支持 RESP3，requirements 已把 redis-py 锁在 5.x 系列
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3

# ---------- PostgreSQL（业务持久化：会话/消息 + checkpoint + 知识库 + 健康报告） ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=123456
PG_DB=petverse_ai
# 连接池上下限（psycopg3 同步池 + asyncio.to_thread）
PG_POOL_MIN=1
PG_POOL_MAX=10
# 前置：该库需已安装 pgvector 扩展（CREATE EXTENSION vector），否则知识检索不可用

# ---------- RAG 检索参数（混合检索：向量 + BM25 关键词） ----------
# 总开关：关闭后知识类提问跳过检索直接生成
RAG_ENABLED=true
# 最终注入 Prompt 的知识片段数（评测标定值 5）
RAG_TOP_K=5
# 每条通道（向量 / 关键词）各自的候选召回数，融合后截到 RAG_TOP_K
RAG_RECALL_K=20
# 向量通道门槛：余弦相似度（1-距离）低于此值且关键词未命中则丢弃
RAG_MIN_SIM=0.30
# 关键词通道门槛：纯关键词命中时，至少命中这么多个查询词才可信
RAG_LEX_MIN_TERMS=2
# 融合权重：向量通道占比（0=纯关键词，1=纯向量）
# 0.85 是 scripts/eval_rag.py 在 83 条黄金集上扫描出来的：低于 0.75 时
# 关键词噪声会压过强语义命中，hit@1 反而不如纯向量
RAG_FUSION_ALPHA=0.85
# 物种不符的片段处理方式：false 按 RAG_SPECIES_PENALTY 降权（默认，更宽容）；
# true 直接剔除
RAG_SPECIES_STRICT=false
RAG_SPECIES_PENALTY=0.5
# 多轮追问改写：把「那它还不吃呢」补全成可独立检索的自包含问句
# 仅影响检索用文本，不改用户可见消息；LLM 失败或 mock 模式自动退回原句
RAG_QUERY_REWRITE=true
# 提问不短于此长度且不含指代词时认为已自包含，跳过改写（省一次 LLM 调用）
RAG_REWRITE_MIN_CHARS=12

# ---------- 知识库语料与切分 ----------
# 语料目录（递归扫描 md / pdf / docx / doc），留空用服务内 app/knowledge
KNOWLEDGE_DIR=
# 片段长度按中文字符数计：目标 / 小节合并下限 / 硬上限（表格按行分组也不超上限）
KB_CHUNK_SIZE=600
KB_CHUNK_MIN=80
KB_CHUNK_MAX=900
# 单次 Embedding 请求的片段条数（服务商上限，阿里云系多为 10）
EMBED_BATCH_SIZE=10
# 知识库文档上传大小上限（MB）
KB_MAX_UPLOAD_MB=20
# 上传文档的原文留存目录（在线预览 PDF 等非纯文本格式要回读原文件），留空用 data/kb
KB_STORAGE_DIR=
# 知识库运维备选令牌：/ai/kb/* 四个接口默认靠网关注入的 X-User-Role=ADMIN 放行
# （前端管理页因此不需要任何令牌）。只有「不经网关直连本服务跑脚本」才需要
# 带请求头 X-Kb-Admin 匹配这个值——留空即关闭该通道。
KB_ADMIN_TOKEN=

# ---------- 业务服务地址（ai-service 直连各微服务拉取上下文，注入内部 X-User-Id） ----------
# 单体部署（PetVerseSingle）时全部指向同一个端口即可
PET_SERVICE_URL=http://127.0.0.1:8081
SPACE_SERVICE_URL=http://127.0.0.1:8082
USER_SERVICE_URL=http://127.0.0.1:8083
SOCIAL_SERVICE_URL=http://127.0.0.1:8084
REMARK_SERVICE_URL=http://127.0.0.1:8085
SHOP_SERVICE_URL=http://127.0.0.1:8087
# 业务服务调用超时（秒），失败降级为空不阻断对话
HTTP_TIMEOUT=8.0

# ---------- 功能缓存 TTL（秒；Redis 热层与 ai_cache 温层共用） ----------
# 评论摘要缓存 6 小时（有新增评论自然过期重建）
REVIEW_SUMMARY_TTL=21600
# 个性化推荐缓存 10 分钟
RECOMMEND_CACHE_TTL=600

# ---------- 对话记忆 ----------
# LLM 上下文窗口条数：compose 从 checkpoint 记忆裁剪最近 N 条控制 token 成本；
# 同时作为存量会话首次接入 checkpoint 时的历史回填上限
HISTORY_MAX_MESSAGES=40

# ---------- 长期记忆（LangGraph 官方 runtime store，跨会话） ----------
# 总开关：关闭后既不注入也不后台抽取（store 表数据保留）
MEMORY_ENABLED=true
# 注入 System Prompt 的记忆条数上限（用户级 + 宠物级合计）
MEMORY_MAX_ITEMS=20

# ---------- LLM 生成参数 ----------
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.8
