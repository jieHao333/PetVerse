AI_SERVICE_NAME=ai-service
AI_SERVICE_IP=127.0.0.1
AI_SERVICE_PORT=8086
NACOS_SERVER_ADDR=localhost:8848

# ---------- 对话模型（OpenAI 兼容格式，改 base_url + model 即可切换任意服务商） ----------
# 例如阿里云百炼：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# 留空 LLM_API_KEY 或 MOCK_CHAT=true 时进入 mock 模式，无需真实调用
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
MOCK_CHAT=true

# ---------- 兼容旧配置（LLM_* 为空时回落到这里） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- Embedding（OpenAI 兼容格式，RAG 检索用；未配置时 RAG 自动降级为关键词检索） ----------
# 阿里云百炼示例：EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                 EMBEDDING_MODEL=text-embedding-v3  EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ---------- 多模态对话附件（图片 / 语音 / 视频，均可选） ----------
# 上传落盘目录（空 = ai-service/data/uploads）；回放走 /ai/chat/media/{uuid}（网关白名单免鉴权）
CHAT_UPLOAD_DIR=
CHAT_MAX_ATTACHMENTS=4
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_AUDIO_MB=20
MEDIA_MAX_VIDEO_MB=50
# 视觉理解模型（OpenAI 兼容多模态对话）；未配置时图片降级为文字占位，不影响对话
# 对话模型本身具备多模态能力时，直接把 LLM_VISION_MODEL 设为与 LLM_MODEL 相同的值即可
# （Key / BaseURL 留空自动复用上方 LLM_* 配置，仅 MODEL 必填）
# 另配独立视觉服务商示例（阿里云百炼）：LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                                    LLM_VISION_MODEL=qwen-vl-plus  LLM_VISION_API_KEY=sk-xxx
LLM_VISION_MODEL=
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=
# 语音转写（OpenAI 兼容 /audio/transcriptions 接口）；未配置时音频降级为文字占位
# 阿里云百炼示例：ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                 ASR_MODEL=paraformer-v2  ASR_API_KEY=sk-xxx
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=3

# ---------- PostgreSQL（会话与消息持久化 + LangGraph checkpoint + RAG 向量库 + 健康报告） ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=123456
PG_DB=petverse_ai
PG_POOL_MIN=1
PG_POOL_MAX=10

# ---------- RAG 检索参数 ----------
RAG_ENABLED=true
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35
RAG_COLLECTION=petverse_kb

# ---------- 业务服务地址（ai-service 直连各微服务拉取上下文） ----------
PET_SERVICE_URL=http://127.0.0.1:8081
SPACE_SERVICE_URL=http://127.0.0.1:8082
USER_SERVICE_URL=http://127.0.0.1:8083
SOCIAL_SERVICE_URL=http://127.0.0.1:8084
REMARK_SERVICE_URL=http://127.0.0.1:8085
SHOP_SERVICE_URL=http://127.0.0.1:8087
HTTP_TIMEOUT=8.0

# ---------- 功能缓存 TTL（秒；Redis 热层与 ai_cache 温层共用） ----------
REVIEW_SUMMARY_TTL=21600
RECOMMEND_CACHE_TTL=600

# ---------- 对话记忆（LLM 上下文窗口；记忆本体由 LangGraph checkpoint 存于 PostgreSQL） ----------
HISTORY_MAX_MESSAGES=40

# ---------- 长期记忆（LangGraph 官方 runtime store，跨会话；存用户 / 宠物偏好） ----------
# 关闭后既不注入对话也不后台抽取（store 表数据保留）；不可用（如 PG 故障）时自动降级
MEMORY_ENABLED=true
# 注入 System Prompt 的记忆条数上限（用户级 + 宠物级合计）
MEMORY_MAX_ITEMS=20

# ---------- LLM 生成参数 ----------
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.8
